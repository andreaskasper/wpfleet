# WP Fleet configuration. Copy to .env next to docker-compose.yml.
FLEET_PUBLIC_URL=https://wpfleet.goo1.de
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts every stored site token. Losing it means reconnecting all sites.
FLEET_KEK=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32
# Traefik sets X-Real-IP; used for per-IP login throttling.
FLEET_IP_HEADER=x-real-ip
# Optional: browser setup instead of the CLI (at least 24 characters, remove after setup)
# FLEET_SETUP_TOKEN=
# MCP clients may only register https redirect URIs on these hosts (and subdomains);
# loopback (Claude Code, Desktop) is always allowed. Default: claude.ai,claude.com
# FLEET_REDIRECT_HOSTS=claude.ai,claude.com
