    "hono": "4.10.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.12",
    "@types/qrcode": "1.5.5",
    "typescript": "5.9.3"
  }
}
